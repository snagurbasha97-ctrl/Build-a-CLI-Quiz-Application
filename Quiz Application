import json
import random


# Load questions from JSON file
def load_questions():
    try:
        with open("questions.json", "r") as file:
            questions = json.load(file)
        return questions

    except FileNotFoundError:
        print("Error: questions.json file not found!")
        return []

    except json.JSONDecodeError:
        print("Error: Invalid JSON file!")
        return []


# Display quiz questions
def run_quiz(questions):
    score = 0
    total = len(questions)

    random.shuffle(questions)

    print("\n================================")
    print("       PYTHON CLI QUIZ")
    print("================================")
    print("Total Questions:", total)
    print("Each correct answer = 1 mark")

    for index, question in enumerate(questions, start=1):

        print(f"\nQuestion {index}: {question['question']}")

        for key, value in question["options"].items():
            print(f"{key}. {value}")

        # Validate user input
        while True:
            answer = input("\nEnter your answer (A/B/C/D): ")
            answer = answer.strip().upper()

            if answer in ["A", "B", "C", "D"]:
                break
            else:
                print("Invalid answer! Please enter A, B, C, or D.")

        # Check answer
        if answer == question["answer"]:
            print("Correct Answer!")
            score += 1
        else:
            print("Wrong Answer!")
            print("Correct answer:", question["answer"])

    return score, total


# Display final result
def show_result(score, total):
    percentage = (score / total) * 100 if total > 0 else 0

    print("\n================================")
    print("         QUIZ RESULT")
    print("================================")

    print("Total Questions :", total)
    print("Correct Answers :", score)
    print("Wrong Answers   :", total - score)
    print("Final Score     :", f"{score}/{total}")
    print("Percentage      :", f"{percentage:.2f}%")

    if percentage >= 80:
        print("Performance: Excellent!")
    elif percentage >= 60:
        print("Performance: Good!")
    elif percentage >= 40:
        print("Performance: Average!")
    else:
        print("Performance: Keep Practicing!")

    print("\nThank you for participating!")


# Main function
def main():
    questions = load_questions()

    if not questions:
        print("Quiz cannot start.")
        return

    score, total = run_quiz(questions)

    show_result(score, total)


# Program execution
if __name__ == "__main__":
    main()
